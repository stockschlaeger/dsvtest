{
  "realm": "dsv",
  "displayName": "Keycloak der Organisation (lokale Nachbildung)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "dsv-web",
      "name": "DSV",
      "description": "Einziger Client der App; Keycloak meldet nur an – Rollen und Rechte verwaltet die App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5001/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5001/*"
      }
    }
  ],
