# Oracle-Altdatenbank (gesetzt = Oracle wird genutzt, DATABASE_URL entfällt)
DB_USER=dsv
DB_PASSWORD=dsv
DB_CONNECT_STRING=localhost:1521/FREEPDB1

# Anmeldung: lokal = Login/Passwort der App (Übergang), keycloak = Keycloak der Organisation
AUTH_MODUS=lokal
# Nur bei lokal (Standardwerte): Sitzung ohne Aktivität in Minuten, Mindestlänge Passwort, Sperre nach Fehlversuchen
# AUTH_SITZUNG_MINUTEN=480
# AUTH_PASSWORT_MIN=10
# AUTH_MAX_FEHLVERSUCHE=5
# AUTH_SPERR_MINUTEN=15
# Cookie nur über HTTPS (Standard: true bei NODE_ENV=production)
# AUTH_COOKIE_SECURE=true

# Nur bei keycloak: Keycloak der Organisation (lokal: docker compose --profile keycloak up -d) – nur Anmeldung
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=dsv
KEYCLOAK_CLIENT_ID=dsv-web

# PostgreSQL mit dem Altbestand (lokal: ../docker-compose.yml); DB_SCHEMA = Schema der DSV_*-Tabellen
DATABASE_URL=postgres://dsv:dsv@localhost:5433/dsv
DB_SCHEMA=dsv
# Ortszeit für LOCALTIMESTAMP (Oracle-DATE/SYSDATE waren Ortszeit)
DB_ZEITZONE=Europe/Berlin

# Logins mit Zugriff auf die Benutzerverwaltung, auch ohne zugeordnete Altkennung – kommagetrennt
DSV_ADMINS=admin
# Rolle der Altanwendung für die Benutzerverwaltung (KLASSE_SY) und GVP-Recht "nur Lesen"
DSV_ADMIN_KLASSE=SY
DSV_RECHT_LESEN=L

# Server
PORT=5001
NODE_ENV=development

# Status-Codes der Altanwendung (nur ändern, wenn DSV_LOV_STATUS im Bestand andere Codes hat)
# DSV_STATUS_NEU=neu
# DSV_STATUS_GG=GG
# DSV_STATUS_SYSTEM=GG,WV,umreg.,Archiv,g
