{
  "name": "dsv-backend",
  "version": "4.0.0",
  "description": "API der DSV – Schriftgutverwaltung auf dem Altbestand (PostgreSQL, lokale Anmeldung oder Keycloak)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch src server.js",
    "db:init": "node scripts/db-init.js",
    "db:beispiele": "node scripts/db-init.js --beispiele",
    "db:app": "node scripts/db-init.js --nur-app",
    "passwort": "node scripts/passwort.js",
    "db:selbsttest": "node scripts/selbsttest.js",
    "logins:uebernehmen": "node scripts/logins-uebernehmen.js",
    "db:nach-ora2pg": "node scripts/nach-ora2pg.js"
  },
  "keywords": [
    "schriftgutverwaltung",
    "e-akte",
    "dms",
    "keycloak"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "jose": "^6.2.13",
    "oracledb": "^6.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=20.12"
  }
}
